# CodeForge AI — variables de entorno (OPCIONAL)
#
# La app NO necesita ninguna variable para funcionar: es 100% client-side.
# Este archivo solo documenta los valores por defecto que puedes sobreescribir
# en build time. Copia a `.env.local` si quieres cambiarlos.
#
# NO pongas claves reales aqui: este archivo se versiona.

# URL de tu instancia propia de Piston. Solo hace falta para proyectos con varios
# archivos: es el unico motor que los admite. La instancia publica emkc.org
# exige lista blanca desde 2026-02-15, asi queJudge0 y Wandbox cubren el resto.
VITE_PISTON_BASE_URL=https://emkc.org/api/v2/piston

# Endpoints por defecto del asistente de IA (se sobreescriben en Ajustes)
VITE_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VITE_AI_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_AI_OLLAMA_BASE_URL=http://localhost:11434